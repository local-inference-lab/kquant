+def shared_h_seed(L, side, r=0):
+    """Stable expert-independent seed for one hidden-side rotation.
+
+    Gate and up share the same calibrated input Hessian within an expert, so
+    they must also share one Hadamard sign draw. Down keeps expert-local SU
+    and shares only its output-side SV draw per TP rank.
+    """
+    side_id = {"gate_up_su": 0, "down_sv": 1}[side]
+    return (0x5EED * 1000003 + L * 65536 + side_id * 4096 + r) & 0x7FFFFFFF
+
+
+def shared_h_profile_paths(work, L):
+    root = os.path.join(work, "shared-h-profiles")
+    return (
+        os.path.join(root, f"shared-h-layer-{L:03d}.safetensors"),
+        os.path.join(root, f"shared-h-layer-{L:03d}.done.json"),
+    )
+
+
+def _shared_h_name(L, proj, r):
+    field = "svh" if proj == "down_proj" else "suh"
+    return f"model.layers.{L}.mlp.experts.shared_h.{proj}.rank{r}.{field}"
+
+
+def _shared_h_encode_kwargs(L, E, proj, proj_idx, r, profiles=None):
+    seed = slice_seed(L, E, proj_idx, r)
+    if proj == "down_proj":
+        kwargs = {"sv_seed": shared_h_seed(L, "down_sv", r)}
+        if profiles is not None:
+            kwargs["forced_svh"] = profiles[(proj, r)]
+    else:
+        kwargs = {
+            "su_seed": shared_h_seed(L, "gate_up_su"),
+            # Keep the sharded output-side rotation expert-local.
+            "sv_seed": seed,
+            # The per-expert scalar belongs on the expert-local side when SU
+            # is shared. This is algebraically identical to dividing SU.
+            "g_scale_into_svh": True,
+        }
+        if profiles is not None:
+            kwargs["forced_suh"] = profiles[(proj, r)]
+    return seed, kwargs
+
+
+def _profile_accumulate(accumulators, key, candidate):
+    torch, _ = _lazy_torch()
+    flat = candidate.detach().flatten().float().cpu()
+    signs = flat.sign().to(torch.int8)
+    magnitude = flat.abs()
+    state = accumulators.get(key)
+    if state is None:
+        state = {
+            "sign": signs,
+            "log_sum": magnitude.clamp_min(1e-30).log().double(),
+            "all_zero": magnitude == 0,
+            "count": 1,
+        }
+        accumulators[key] = state
+        return
+    incompatible = (state["sign"] != signs) & (state["sign"] != 0) & (signs != 0)
+    if incompatible.any().item():
+        raise RuntimeError(f"shared-H sign mismatch for {key}")
+    state["sign"] = torch.where(state["sign"] == 0, signs, state["sign"])
+    state["log_sum"] += magnitude.clamp_min(1e-30).log().double()
+    state["all_zero"] &= magnitude == 0
+    state["count"] += 1
+
+
+def profile_layer_shared_h(
+    src,
+    work,
+    L,
+    out_scales,
+    capture_dir,
+    min_routed,
+    logfile,
+    profile_identity=None,
+):
+    """Derive calibrated shared H-side profiles before the LDLQ encode.
+
+    This is deliberately a separate pass. The auto output-scale decision and
+    channel profiles depend on each expert's calibrated Hessian and weights;
+    deriving them from an already-quantized checkpoint would compound error.
+    """
+    torch, _ = _lazy_torch()
+    st_path, done_path = shared_h_profile_paths(work, L)
+    if os.path.exists(st_path) and os.path.exists(done_path):
+        try:
+            with open(done_path) as handle:
+                done = json.load(handle)
+            if (
+                done.get("file_sha256") == sha256_file(st_path)
+                and done.get("profile_identity") == profile_identity
+            ):
+                return st_path
+        except Exception:
+            pass
+    os.makedirs(os.path.dirname(st_path), exist_ok=True)
+    calib = LayerCalib(capture_dir, L, logfile)
+    accumulators = {}
+    routed_count = []
+    for E in range(NUM_EXPERTS):
+        W = {proj: load_expert_bf16(src, L, E, proj, "cuda:0", logfile) for proj in PROJS}
+        hd_gu, hd_down, hmeta = build_expert_hessians(
+            calib, E, W["gate_proj"], W["up_proj"], "cuda:0", min_routed
+        )
+        routed_count.append(hmeta["routed"])
+        for proj_idx, proj in enumerate(PROJS):
+            for r, sl in expert_slices(W[proj], proj):
+                hd = hd_gu if proj != "down_proj" else hd_down[r]
+                seed, shared_kwargs = _shared_h_encode_kwargs(
+                    L, E, proj, proj_idx, r
+                )
+                ctx = encode_slice_prologue_pre(
+                    sl,
+                    hd,
+                    seed,
+                    out_scales,
+                    logfile=logfile,
+                    **shared_kwargs,
+                )
+                candidate = ctx["sv"] if proj == "down_proj" else ctx["su"]
+                _profile_accumulate(accumulators, (proj, r), candidate)
+                ctx.clear()
+        free_H_data(hd_gu, *hd_down)
+        del W
+        if E % 32 == 31:
+            log(f"layer {L}: shared-H profile {E + 1}/{NUM_EXPERTS}", logfile)
+    entries = []
+    for proj in PROJS:
+        for r in range(TP):
+            state = accumulators[(proj, r)]
+            profile = state["sign"].double() * (
+                state["log_sum"] / state["count"]
+            ).exp()
+            profile[state["all_zero"]] = 0
+            profile = profile.half().contiguous()
+            name = _shared_h_name(L, proj, r)
+            entries.append((name, "F16", tuple(profile.shape), profile.numpy().tobytes()))
+    _, file_sha = write_safetensors(st_path, entries, metadata={"format": "pt"})
+    payload = {
+        "schema": "glm52-exl3-shared-h-profile-v1",
+        "layer": L,
+        "experts": NUM_EXPERTS,
+        "aggregation": "signed-geometric-mean",
+        "profile_identity": profile_identity,
+        "capture_tokens": calib.tokens,
+        "expert_routed_count": routed_count,
+        "file": os.path.basename(st_path),
+        "file_sha256": file_sha,
+    }
+    tmp = done_path + ".tmp"
+    with open(tmp, "w") as handle:
+        json.dump(payload, handle, indent=1)
+    os.replace(tmp, done_path)
+    del calib
+    return st_path
+
+
+def load_layer_shared_h_profiles(
+    work, L, device="cuda:0", expected_identity=None
+):
+    torch, _ = _lazy_torch()
+    import numpy as np
+
+    st_path, done_path = shared_h_profile_paths(work, L)
+    if not (os.path.exists(st_path) and os.path.exists(done_path)):
+        raise RuntimeError(f"layer {L}: shared-H profile is missing")
+    with open(done_path) as handle:
+        done = json.load(handle)
+    if done.get("file_sha256") != sha256_file(st_path):
+        raise RuntimeError(f"layer {L}: shared-H profile hash mismatch")
+    if done.get("profile_identity") != expected_identity:
+        raise RuntimeError(f"layer {L}: shared-H profile identity mismatch")
+    reader = STReader(st_path)
+    profiles = {}
+    for proj in PROJS:
+        for r in range(TP):
+            name = _shared_h_name(L, proj, r)
+            dtype, shape, _, _ = reader.tensors[name]
+            if dtype != "F16":
+                raise RuntimeError(f"{name}: expected F16, got {dtype}")
+            array = np.frombuffer(reader.read_bytes(name), dtype=np.float16).copy()
+            vector = torch.from_numpy(array).to(device=device, dtype=torch.float32)
+            profiles[(proj, r)] = (
+                vector.view(1, -1) if proj == "down_proj" else vector.view(-1, 1)
+            )
+    return profiles, done
+
